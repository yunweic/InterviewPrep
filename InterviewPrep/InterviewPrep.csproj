<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>Recommended</AnalysisMode>
        <!-- LeetCode-provided types (e.g. ListNode/TreeNode) intentionally use public fields with no namespace -->
        <!-- ToUpper/ToLower/StartsWith etc. intentionally use the plain overloads you'd actually write
             in an interview, not the culture-aware ones (StringComparison.Ordinal, CultureInfo) -->
        <!-- LINQ's Count() is intentionally called on List<T>/string in ListsDemo/StringsDemo to
             demonstrate its dynamic ICollection<T> fast-path check, not as the idiomatic way to
             get a size (which would rightly be Count/Length instead) -->
        <NoWarn>CA1051;CA1050;CA1304;CA1305;CA1310;CA1311;CA1829</NoWarn>
    </PropertyGroup>

</Project>
